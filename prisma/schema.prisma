// Brand AI — foundation schema.
// Only foundation tables live here at initialization. Each phase extends the
// schema through its own migration (see docs/DATABASE_DESIGN.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────────────────────
// Identity & authentication
// ─────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid()) @db.Char(36)
  email            String    @unique @db.VarChar(320)
  name             String    @db.VarChar(120)
  passwordHash     String?   @map("password_hash") @db.VarChar(255)
  emailVerifiedAt  DateTime? @map("email_verified_at")
  image            String?   @db.VarChar(2048)
  // Incremented to invalidate every existing session (password change, "log out everywhere").
  sessionVersion   Int       @default(0) @map("session_version")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  isPlatformAdmin  Boolean   @default(false) @map("is_platform_admin")
  // Phase 10: TOTP two-factor sign-in. The secret is AES-256-GCM encrypted; recovery codes are SHA-256 hashes.
  mfaSecret        String?   @map("mfa_secret") @db.VarChar(255)
  mfaEnabledAt     DateTime? @map("mfa_enabled_at")
  mfaRecoveryCodes Json?     @map("mfa_recovery_codes")
  mfaLastStep      Int?      @map("mfa_last_step")
  // Phase 10: a platform admin can suspend an account (sign-in refused, sessions revoked).
  suspendedAt      DateTime? @map("suspended_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  authTokens              AuthToken[]
  memberships             WorkspaceMember[]
  ownedWorkspaces         Workspace[]              @relation("WorkspaceOwner")
  businessesCreated       Business[]               @relation("BusinessCreatedBy")
  contextVersions         BusinessContextVersion[] @relation("ContextCreatedBy")
  contextApprovals        BusinessContextVersion[] @relation("ContextApprovedBy")
  aiGenerations           AiGeneration[]
  aiUsageRecords          AiUsageRecord[]
  storedFiles             StoredFile[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  projectsCreated         Project[]                @relation("ProjectCreatedBy")
  projectOutputs          ProjectOutput[]
  brandIdentitiesCreated  BrandIdentity[]          @relation("BrandIdentityCreatedBy")
  brandIdentitiesApproved BrandIdentity[]          @relation("BrandIdentityApprovedBy")
  brandAssets             BrandAsset[]
  marketingPlansCreated   MarketingPlan[]          @relation("MarketingPlanCreatedBy")
  marketingPlansApproved  MarketingPlan[]          @relation("MarketingPlanApprovedBy")
  invitationsSent         WorkspaceInvitation[]    @relation("InvitationInvitedBy")

  @@index([deletedAt])
  @@map("users")
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// Single-use tokens. Only a SHA-256 hash of the token is stored.
model AuthToken {
  id        String        @id @default(uuid()) @db.Char(36)
  userId    String        @map("user_id") @db.Char(36)
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

// ─────────────────────────────────────────────────────────────
// Workspaces (tenancy boundary)
// ─────────────────────────────────────────────────────────────

enum WorkspaceType {
  PERSONAL
  TEAM
  AGENCY
}

model Workspace {
  id                String        @id @default(uuid()) @db.Char(36)
  name              String        @db.VarChar(120)
  slug              String        @unique @db.VarChar(80)
  type              WorkspaceType @default(PERSONAL)
  ownerId           String        @map("owner_id") @db.Char(36)
  // Phase 10: a client workspace managed by an agency workspace (shares the agency's plan and AI credits).
  agencyWorkspaceId String?       @map("agency_workspace_id") @db.Char(36)
  // Phase 10: suspended by a platform admin (members can't open it).
  suspendedAt       DateTime?     @map("suspended_at")
  // The AI learns from outputs this workspace approves (examples per business and task). Off = no learning, no use.
  aiLearningEnabled Boolean       @default(true) @map("ai_learning_enabled")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  owner              User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  agency             Workspace?            @relation("AgencyClients", fields: [agencyWorkspaceId], references: [id], onDelete: SetNull)
  clientWorkspaces   Workspace[]           @relation("AgencyClients")
  subscription       Subscription?
  creditLedger       AiCreditEntry[]
  agencyClients      AgencyClient[]        @relation("AgencyClientAgency")
  clientProfile      AgencyClient?         @relation("AgencyClientWorkspace")
  aiExamples         AiExample[]
  members            WorkspaceMember[]
  businesses         Business[]
  aiGenerations      AiGeneration[]
  aiUsageRecords     AiUsageRecord[]
  usageLimits        UsageLimit[]
  storedFiles        StoredFile[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  projects           Project[]
  brandIdentities    BrandIdentity[]
  brandAssets        BrandAsset[]
  marketingPlans     MarketingPlan[]
  designs            Design[]
  websites           Website[]
  websiteSubmissions WebsiteSubmission[]
  materials          BrandMaterial[]
  documents          BusinessDocument[]
  automationSettings AutomationSettings?
  integrations       Integration[]
  scheduledItems     ScheduledItem[]
  emailContacts      EmailContact[]
  emailCampaigns     EmailCampaign[]
  reminders          Reminder[]
  automationRules    AutomationRule[]
  automationRuns     AutomationRun[]
  siteViews          SiteView[]
  emailEvents        EmailEvent[]
  postMetrics        PostMetric[]
  analyticsReports   AnalyticsReport[]
  analyticsSettings  AnalyticsSettings?
  invitations        WorkspaceInvitation[]

  @@index([ownerId])
  @@index([deletedAt])
  @@index([agencyWorkspaceId])
  @@map("workspaces")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Char(36)
  workspaceId String        @map("workspace_id") @db.Char(36)
  userId      String        @map("user_id") @db.Char(36)
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ─────────────────────────────────────────────────────────────
// Businesses & central business context
// ─────────────────────────────────────────────────────────────

enum BusinessStage {
  IDEA
  STARTING
  OPERATING
  ESTABLISHED
}

enum BusinessStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Business {
  id               String         @id @default(uuid()) @db.Char(36)
  workspaceId      String         @map("workspace_id") @db.Char(36)
  name             String         @db.VarChar(160)
  industry         String?        @db.VarChar(120)
  description      String?        @db.Text
  stage            BusinessStage  @default(IDEA)
  status           BusinessStatus @default(DRAFT)
  valueProposition String?        @map("value_proposition") @db.Text
  businessModel    String?        @map("business_model") @db.Text
  createdById      String         @map("created_by_id") @db.Char(36)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  workspace        Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User                      @relation("BusinessCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  contextVersions  BusinessContextVersion[]
  aiGenerations    AiGeneration[]
  storedFiles      StoredFile[]
  projects         Project[]
  brandIdentities  BrandIdentity[]
  brandAssets      BrandAsset[]
  marketingPlans   MarketingPlan[]
  products         BusinessProduct[]
  services         BusinessService[]
  locations        BusinessLocation[]
  audiences        BusinessAudience[]
  problems         BusinessCustomerProblem[]
  competitors      Competitor[]
  goals            BusinessGoal[]
  designs          Design[]
  websites         Website[]
  materials        BrandMaterial[]
  documents        BusinessDocument[]
  details          BusinessDetails?
  scheduledItems   ScheduledItem[]
  emailContacts    EmailContact[]
  emailCampaigns   EmailCampaign[]
  postMetrics      PostMetric[]
  analyticsReports AnalyticsReport[]
  aiExamples       AiExample[]

  @@index([workspaceId, deletedAt])
  @@index([createdById])
  @@map("businesses")
}

enum ContextVersionStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

// Versioned snapshot of the central business context. AI modules only ever
// receive the sections listed in `approvedSections` of the latest APPROVED version.
model BusinessContextVersion {
  id               String               @id @default(uuid()) @db.Char(36)
  businessId       String               @map("business_id") @db.Char(36)
  version          Int
  status           ContextVersionStatus @default(DRAFT)
  data             Json
  approvedSections Json                 @map("approved_sections")
  changeNote       String?              @map("change_note") @db.VarChar(500)
  createdById      String               @map("created_by_id") @db.Char(36)
  approvedById     String?              @map("approved_by_id") @db.Char(36)
  approvedAt       DateTime?            @map("approved_at")
  createdAt        DateTime             @default(now()) @map("created_at")

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("ContextCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?          @relation("ContextApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  generations AiGeneration[]

  @@unique([businessId, version])
  @@index([businessId, status])
  @@map("business_context_versions")
}

// ─────────────────────────────────────────────────────────────
// AI generations & usage tracking
// ─────────────────────────────────────────────────────────────

enum AiKind {
  TEXT
  IMAGE
}

enum AiGenerationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model AiGeneration {
  id               String             @id @default(uuid()) @db.Char(36)
  workspaceId      String             @map("workspace_id") @db.Char(36)
  businessId       String?            @map("business_id") @db.Char(36)
  userId           String             @map("user_id") @db.Char(36)
  contextVersionId String?            @map("context_version_id") @db.Char(36)
  module           String             @db.VarChar(60)
  task             String             @db.VarChar(80)
  kind             AiKind
  provider         String             @db.VarChar(40)
  model            String             @db.VarChar(120)
  status           AiGenerationStatus @default(PENDING)
  input            Json
  output           Json?
  errorCode        String?            @map("error_code") @db.VarChar(80)
  errorMessage     String?            @map("error_message") @db.VarChar(1000)
  latencyMs        Int?               @map("latency_ms")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business       Business?               @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  contextVersion BusinessContextVersion? @relation(fields: [contextVersionId], references: [id], onDelete: SetNull)
  usageRecords   AiUsageRecord[]
  projectOutputs ProjectOutput[]

  @@index([workspaceId, createdAt])
  @@index([businessId, module])
  @@index([userId])
  @@map("ai_generations")
}

model AiUsageRecord {
  id           String   @id @default(uuid()) @db.Char(36)
  workspaceId  String   @map("workspace_id") @db.Char(36)
  userId       String   @map("user_id") @db.Char(36)
  generationId String?  @map("generation_id") @db.Char(36)
  provider     String   @db.VarChar(40)
  model        String   @db.VarChar(120)
  kind         AiKind
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  imageCount   Int      @default(0) @map("image_count")
  // Estimated cost in micro-USD (1 USD = 1,000,000) to avoid floating point drift.
  costMicroUsd BigInt   @default(0) @map("cost_micro_usd")
  createdAt    DateTime @default(now()) @map("created_at")

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  generation AiGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage_records")
}

enum UsageMetric {
  AI_TEXT_REQUESTS
  AI_IMAGE_REQUESTS
  AI_COST_MICRO_USD
  STORAGE_BYTES
}

enum UsagePeriod {
  DAILY
  MONTHLY
}

model UsageLimit {
  id          String      @id @default(uuid()) @db.Char(36)
  workspaceId String      @map("workspace_id") @db.Char(36)
  metric      UsageMetric
  period      UsagePeriod @default(MONTHLY)
  limitValue  BigInt      @map("limit_value")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, metric, period])
  @@map("usage_limits")
}

// ─────────────────────────────────────────────────────────────
// Files (metadata only — bytes live in cloud storage)
// ─────────────────────────────────────────────────────────────

model StoredFile {
  id           String    @id @default(uuid()) @db.Char(36)
  workspaceId  String    @map("workspace_id") @db.Char(36)
  businessId   String?   @map("business_id") @db.Char(36)
  uploadedById String    @map("uploaded_by_id") @db.Char(36)
  provider     String    @db.VarChar(40)
  bucket       String    @db.VarChar(120)
  objectKey    String    @unique @map("object_key") @db.VarChar(512)
  originalName String    @map("original_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(120)
  sizeBytes    Int       @map("size_bytes")
  checksum     String    @db.Char(64)
  purpose      String    @db.VarChar(60)
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business    Business?    @relation(fields: [businessId], references: [id], onDelete: SetNull)
  uploadedBy  User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  brandAssets BrandAsset[]

  @@index([workspaceId, deletedAt])
  @@index([businessId])
  @@map("stored_files")
}

// ─────────────────────────────────────────────────────────────
// Notifications, audit logging, rate limiting
// ─────────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  workspaceId String?   @map("workspace_id") @db.Char(36)
  type        String    @db.VarChar(60)
  title       String    @db.VarChar(200)
  body        String?   @db.Text
  link        String?   @db.VarChar(500)
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Char(36)
  workspaceId String?  @map("workspace_id") @db.Char(36)
  actorId     String?  @map("actor_id") @db.Char(36)
  action      String   @db.VarChar(100)
  entityType  String?  @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// Fixed-window counters shared by all app instances (serverless-safe).
// Replaced by Redis when Redis is introduced for background jobs.
model RateLimitBucket {
  key       String   @id @db.VarChar(191)
  count     Int
  resetAt   DateTime @map("reset_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

// ─────────────────────────────────────────────────────────────
// Phase 1 — Studio projects & versioned section outputs
// ─────────────────────────────────────────────────────────────

enum ProjectType {
  LAUNCH_STUDIO
  BRAND_STUDIO
  STRATEGY_STUDIO
  SOCIAL_STUDIO
  COMPANY_PROFILE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

// A studio session for a business (Phase 1: Launch Studio). Later studios
// reuse this table with their own ProjectType.
model Project {
  id          String        @id @default(uuid()) @db.Char(36)
  workspaceId String        @map("workspace_id") @db.Char(36)
  businessId  String        @map("business_id") @db.Char(36)
  type        ProjectType
  name        String        @db.VarChar(160)
  status      ProjectStatus @default(ACTIVE)
  input       Json
  createdById String        @map("created_by_id") @db.Char(36)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy       User            @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  outputs         ProjectOutput[]
  brandIdentities BrandIdentity[]
  marketingPlans  MarketingPlan[]
  socialPosts     SocialPost[]

  @@index([workspaceId, deletedAt])
  @@index([businessId, type])
  @@map("projects")
}

enum OutputSource {
  AI
  EDIT
}

// Append-only versions of one section's output. `state` holds user progress
// (e.g. checklist ticks) that is not part of the generated content.
model ProjectOutput {
  id           String       @id @default(uuid()) @db.Char(36)
  projectId    String       @map("project_id") @db.Char(36)
  section      String       @db.VarChar(60)
  version      Int
  source       OutputSource
  content      Json
  state        Json?
  isAccepted   Boolean      @default(false) @map("is_accepted")
  isMock       Boolean      @default(false) @map("is_mock")
  feedback     String?      @db.VarChar(1000)
  generationId String?      @map("generation_id") @db.Char(36)
  createdById  String       @map("created_by_id") @db.Char(36)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generation AiGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  createdBy  User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, section, version])
  @@index([projectId, section, isAccepted])
  @@map("project_outputs")
}

// ─────────────────────────────────────────────────────────────
// Phase 1 — Structured business profile
// Access is always through an authorized, workspace-scoped business.
// ─────────────────────────────────────────────────────────────

model BusinessProduct {
  id          String   @id @default(uuid()) @db.Char(36)
  businessId  String   @map("business_id") @db.Char(36)
  name        String   @db.VarChar(160)
  description String?  @db.Text
  priceRange  String?  @map("price_range") @db.VarChar(120)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sortOrder])
  @@map("business_products")
}

model BusinessService {
  id          String   @id @default(uuid()) @db.Char(36)
  businessId  String   @map("business_id") @db.Char(36)
  name        String   @db.VarChar(160)
  description String?  @db.Text
  priceRange  String?  @map("price_range") @db.VarChar(120)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sortOrder])
  @@map("business_services")
}

model BusinessLocation {
  id         String   @id @default(uuid()) @db.Char(36)
  businessId String   @map("business_id") @db.Char(36)
  label      String?  @db.VarChar(120)
  city       String?  @db.VarChar(120)
  region     String?  @db.VarChar(120)
  country    String   @db.VarChar(120)
  isPrimary  Boolean  @default(false) @map("is_primary")
  isOnline   Boolean  @default(false) @map("is_online")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_locations")
}

model BusinessAudience {
  id           String   @id @default(uuid()) @db.Char(36)
  businessId   String   @map("business_id") @db.Char(36)
  name         String   @db.VarChar(160)
  description  String?  @db.Text
  demographics String?  @db.Text
  needs        String?  @db.Text
  isPrimary    Boolean  @default(false) @map("is_primary")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sortOrder])
  @@map("business_audiences")
}

model BusinessCustomerProblem {
  id         String   @id @default(uuid()) @db.Char(36)
  businessId String   @map("business_id") @db.Char(36)
  problem    String   @db.Text
  solution   String?  @db.Text
  severity   String?  @db.VarChar(20)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sortOrder])
  @@map("business_customer_problems")
}

model Competitor {
  id          String   @id @default(uuid()) @db.Char(36)
  businessId  String   @map("business_id") @db.Char(36)
  name        String   @db.VarChar(160)
  website     String?  @db.VarChar(500)
  description String?  @db.Text
  strengths   String?  @db.Text
  weaknesses  String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sortOrder])
  @@map("competitors")
}

model BusinessGoal {
  id          String   @id @default(uuid()) @db.Char(36)
  businessId  String   @map("business_id") @db.Char(36)
  title       String   @db.VarChar(200)
  description String?  @db.Text
  timeframe   String?  @db.VarChar(120)
  metric      String?  @db.VarChar(200)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sortOrder])
  @@map("business_goals")
}

// ─────────────────────────────────────────────────────────────
// Phase 2 — Brand identity & brand assets
// ─────────────────────────────────────────────────────────────

enum BrandIdentityStatus {
  APPROVED
  SUPERSEDED
}

// Immutable snapshot of an approved brand identity (logo spec, palette,
// typography, tagline, personality, voice, guidelines). The newest APPROVED
// row is the business's current identity; older ones are kept as history.
model BrandIdentity {
  id           String              @id @default(uuid()) @db.Char(36)
  workspaceId  String              @map("workspace_id") @db.Char(36)
  businessId   String              @map("business_id") @db.Char(36)
  projectId    String?             @map("project_id") @db.Char(36)
  version      Int
  status       BrandIdentityStatus @default(APPROVED)
  data         Json
  createdById  String              @map("created_by_id") @db.Char(36)
  approvedById String              @map("approved_by_id") @db.Char(36)
  approvedAt   DateTime            @default(now()) @map("approved_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy  User      @relation("BrandIdentityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User      @relation("BrandIdentityApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([businessId, version])
  @@index([businessId, status])
  @@map("brand_identities")
}

enum BrandAssetKind {
  LOGO
  ICON
  IMAGE
  DOCUMENT
  OTHER
}

// Uploaded brand files (generated logo variants are rendered on demand from
// the approved identity and are not stored here).
model BrandAsset {
  id           String         @id @default(uuid()) @db.Char(36)
  workspaceId  String         @map("workspace_id") @db.Char(36)
  businessId   String         @map("business_id") @db.Char(36)
  storedFileId String         @map("stored_file_id") @db.Char(36)
  kind         BrandAssetKind @default(OTHER)
  name         String         @db.VarChar(160)
  description  String?        @db.VarChar(1000)
  createdById  String         @map("created_by_id") @db.Char(36)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  createdBy  User       @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([businessId, deletedAt])
  @@index([workspaceId])
  @@map("brand_assets")
}

// Bytes for STORAGE_PROVIDER=database (free, zero-setup storage for small
// files). Replaced by S3-compatible storage at scale.
model StorageObject {
  objectKey   String   @id @map("object_key") @db.VarChar(512)
  contentType String   @map("content_type") @db.VarChar(120)
  sizeBytes   Int      @map("size_bytes")
  data        Bytes    @db.LongBlob
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("storage_objects")
}

// ─────────────────────────────────────────────────────────────
// Phase 3 — Approved marketing plans
// ─────────────────────────────────────────────────────────────

enum MarketingPlanStatus {
  APPROVED
  SUPERSEDED
}

// Immutable snapshot of an approved marketing strategy (personas, channels,
// objectives, budget, advertising, KPIs, strategy). Newest APPROVED is current.
model MarketingPlan {
  id           String              @id @default(uuid()) @db.Char(36)
  workspaceId  String              @map("workspace_id") @db.Char(36)
  businessId   String              @map("business_id") @db.Char(36)
  projectId    String?             @map("project_id") @db.Char(36)
  version      Int
  status       MarketingPlanStatus @default(APPROVED)
  data         Json
  createdById  String              @map("created_by_id") @db.Char(36)
  approvedById String              @map("approved_by_id") @db.Char(36)
  approvedAt   DateTime            @default(now()) @map("approved_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy  User      @relation("MarketingPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User      @relation("MarketingPlanApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([businessId, version])
  @@index([businessId, status])
  @@map("marketing_plans")
}

// ─────────────────────────────────────────────────────────────
// Phase 4 — Social media posts
// ─────────────────────────────────────────────────────────────

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
}

enum SocialFormat {
  POST
  CAROUSEL
  STORY
  SHORT_VIDEO
}

enum SocialPostStatus {
  IDEA
  DRAFT
  READY
}

// A planned or written social post. `content` holds the current text
// (caption, hashtags, slides, frames, script, promotion…); every change is
// kept in social_post_revisions.
model SocialPost {
  id               String           @id @default(uuid()) @db.Char(36)
  workspaceId      String           @map("workspace_id") @db.Char(36)
  businessId       String           @map("business_id") @db.Char(36)
  projectId        String           @map("project_id") @db.Char(36)
  calendarOutputId String?          @map("calendar_output_id") @db.Char(36)
  scheduledDate    DateTime         @map("scheduled_date") @db.Date
  platform         SocialPlatform
  format           SocialFormat
  pillar           String?          @db.VarChar(120)
  title            String           @db.VarChar(200)
  objective        String?          @db.VarChar(500)
  isPromotion      Boolean          @default(false) @map("is_promotion")
  status           SocialPostStatus @default(IDEA)
  content          Json?
  version          Int              @default(0)
  isMock           Boolean          @default(false) @map("is_mock")
  createdById      String           @map("created_by_id") @db.Char(36)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions SocialPostRevision[]

  @@index([projectId, scheduledDate])
  @@index([workspaceId, deletedAt])
  @@index([businessId])
  @@map("social_posts")
}

enum SocialRevisionSource {
  AI
  EDIT
}

model SocialPostRevision {
  id           String               @id @default(uuid()) @db.Char(36)
  postId       String               @map("post_id") @db.Char(36)
  version      Int
  source       SocialRevisionSource
  content      Json
  feedback     String?              @db.VarChar(1000)
  generationId String?              @map("generation_id") @db.Char(36)
  createdById  String               @map("created_by_id") @db.Char(36)
  createdAt    DateTime             @default(now()) @map("created_at")

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, version])
  @@map("social_post_revisions")
}

// ─────────────────────────────────────────────────────────────
// Phase 5 — Designs (structured specs rendered to SVG/PNG on demand)
// ─────────────────────────────────────────────────────────────

enum DesignKind {
  POSTER
  FLYER
  AD
  BANNER
  PRODUCT
  EVENT
  SOCIAL
}

// A saved design. `spec` holds the template, colour scheme and copy; the
// artwork itself is rendered from the spec + the approved brand identity.
model Design {
  id           String     @id @default(uuid()) @db.Char(36)
  workspaceId  String     @map("workspace_id") @db.Char(36)
  businessId   String     @map("business_id") @db.Char(36)
  kind         DesignKind
  format       String     @db.VarChar(40)
  name         String     @db.VarChar(160)
  brief        Json
  spec         Json
  imageFileId  String?    @map("image_file_id") @db.Char(36)
  sourcePostId String?    @map("source_post_id") @db.Char(36)
  version      Int        @default(1)
  isMock       Boolean    @default(false) @map("is_mock")
  createdById  String     @map("created_by_id") @db.Char(36)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  revisions DesignRevision[]

  @@index([workspaceId, deletedAt])
  @@index([businessId, kind])
  @@map("designs")
}

model DesignRevision {
  id          String   @id @default(uuid()) @db.Char(36)
  designId    String   @map("design_id") @db.Char(36)
  version     Int
  format      String   @db.VarChar(40)
  spec        Json
  imageFileId String?  @map("image_file_id") @db.Char(36)
  createdById String   @map("created_by_id") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, version])
  @@map("design_revisions")
}

// ── Phase 6: Website Builder ────────────────────────────────────────────────

enum WebsiteType {
  BUSINESS
  LANDING
  PORTFOLIO
  STORE
}

enum WebsiteStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

// A business website. `config` is the editable draft (pages → sections of
// whitelisted types). Publishing snapshots config + brand into website_versions;
// the public site renders only the published snapshot.
model Website {
  id               String        @id @default(uuid()) @db.Char(36)
  workspaceId      String        @map("workspace_id") @db.Char(36)
  businessId       String        @map("business_id") @db.Char(36)
  type             WebsiteType
  name             String        @db.VarChar(160)
  slug             String        @unique @db.VarChar(63)
  status           WebsiteStatus @default(DRAFT)
  config           Json
  draftRevision    Int           @default(1) @map("draft_revision")
  publishedVersion Int?          @map("published_version")
  publishedAt      DateTime?     @map("published_at")
  customDomain     String?       @unique @map("custom_domain") @db.VarChar(253)
  domainStatus     DomainStatus? @map("domain_status")
  domainToken      String?       @map("domain_token") @db.Char(32)
  domainCheckedAt  DateTime?     @map("domain_checked_at")
  isMock           Boolean       @default(false) @map("is_mock")
  createdById      String        @map("created_by_id") @db.Char(36)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  versions    WebsiteVersion[]
  submissions WebsiteSubmission[]
  views       SiteView[]

  @@index([workspaceId, deletedAt])
  @@index([businessId])
  @@map("websites")
}

model WebsiteVersion {
  id            String   @id @default(uuid()) @db.Char(36)
  websiteId     String   @map("website_id") @db.Char(36)
  version       Int
  config        Json
  brand         Json
  publishedById String   @map("published_by_id") @db.Char(36)
  publishedAt   DateTime @default(now()) @map("published_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, version])
  @@map("website_versions")
}

// Contact / order enquiries sent from a published site's form.
model WebsiteSubmission {
  id          String    @id @default(uuid()) @db.Char(36)
  websiteId   String    @map("website_id") @db.Char(36)
  workspaceId String    @map("workspace_id") @db.Char(36)
  kind        String    @db.VarChar(20)
  name        String    @db.VarChar(120)
  email       String    @db.VarChar(254)
  phone       String?   @db.VarChar(40)
  message     String    @db.Text
  item        String?   @db.VarChar(200)
  pagePath    String    @map("page_path") @db.VarChar(200)
  ipHash      String    @map("ip_hash") @db.Char(64)
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  website   Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([websiteId, createdAt])
  @@index([workspaceId])
  @@map("website_submissions")
}

// ── Phase 7: Stationery & Merchandise ───────────────────────────────────────

// Company details printed on stationery and documents (one row per business).
model BusinessDetails {
  id                 String   @id @default(uuid()) @db.Char(36)
  businessId         String   @unique @map("business_id") @db.Char(36)
  legalName          String?  @map("legal_name") @db.VarChar(200)
  addressLine1       String?  @map("address_line1") @db.VarChar(200)
  addressLine2       String?  @map("address_line2") @db.VarChar(200)
  city               String?  @db.VarChar(120)
  postcode           String?  @db.VarChar(40)
  country            String?  @db.VarChar(120)
  email              String?  @db.VarChar(254)
  phone              String?  @db.VarChar(40)
  website            String?  @db.VarChar(300)
  registrationNumber String?  @map("registration_number") @db.VarChar(80)
  taxNumber          String?  @map("tax_number") @db.VarChar(80)
  bankDetails        String?  @map("bank_details") @db.Text
  currency           String   @default("GBP") @db.Char(3)
  defaultTaxRateBp   Int      @default(0) @map("default_tax_rate_bp")
  paymentTermsDays   Int      @default(14) @map("payment_terms_days")
  invoicePrefix      String   @default("INV-") @map("invoice_prefix") @db.VarChar(12)
  quotePrefix        String   @default("QUO-") @map("quote_prefix") @db.VarChar(12)
  nextInvoiceNumber  Int      @default(1) @map("next_invoice_number")
  nextQuoteNumber    Int      @default(1) @map("next_quote_number")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_details")
}

enum MaterialKind {
  BUSINESS_CARD
  LETTERHEAD
  TSHIRT
  UNIFORM
  BAG
  MUG
  LABEL
  PACKAGING
}

// A branded print or merchandise item. `spec` holds validated layout/content;
// artwork and mockups are drawn from it with the approved brand.
model BrandMaterial {
  id          String       @id @default(uuid()) @db.Char(36)
  workspaceId String       @map("workspace_id") @db.Char(36)
  businessId  String       @map("business_id") @db.Char(36)
  kind        MaterialKind
  name        String       @db.VarChar(160)
  spec        Json
  version     Int          @default(1)
  isMock      Boolean      @default(false) @map("is_mock")
  createdById String       @map("created_by_id") @db.Char(36)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business  Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  revisions BrandMaterialRevision[]

  @@index([workspaceId, deletedAt])
  @@index([businessId, kind])
  @@map("brand_materials")
}

model BrandMaterialRevision {
  id          String   @id @default(uuid()) @db.Char(36)
  materialId  String   @map("material_id") @db.Char(36)
  version     Int
  spec        Json
  createdById String   @map("created_by_id") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")

  material BrandMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, version])
  @@map("brand_material_revisions")
}

enum DocumentType {
  INVOICE
  QUOTE
}

enum DocumentStatus {
  DRAFT
  SENT
  PAID
  ACCEPTED
  DECLINED
  VOID
}

// Invoices and quotations. Money is stored in minor units (BigInt); totals are
// computed in code from the lines and stored for listing/reporting.
model BusinessDocument {
  id            String         @id @default(uuid()) @db.Char(36)
  workspaceId   String         @map("workspace_id") @db.Char(36)
  businessId    String         @map("business_id") @db.Char(36)
  type          DocumentType
  number        String         @db.VarChar(40)
  status        DocumentStatus @default(DRAFT)
  customer      Json
  issueDate     DateTime       @map("issue_date") @db.Date
  dueDate       DateTime?      @map("due_date") @db.Date
  currency      String         @db.Char(3)
  lines         Json
  intro         String?        @db.Text
  notes         String?        @db.Text
  terms         String?        @db.Text
  subtotalMinor BigInt         @map("subtotal_minor")
  taxMinor      BigInt         @map("tax_minor")
  totalMinor    BigInt         @map("total_minor")
  sourceQuoteId String?        @map("source_quote_id") @db.Char(36)
  sentAt        DateTime?      @map("sent_at")
  paidAt        DateTime?      @map("paid_at")
  createdById   String         @map("created_by_id") @db.Char(36)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, type, number])
  @@index([workspaceId, deletedAt])
  @@index([businessId, type, status])
  @@map("business_documents")
}

// ── Phase 8: Calendar & Automation ──────────────────────────────────────────

enum AutomationMode {
  DRAFT_ONLY
  APPROVAL_REQUIRED
  AUTOMATED
}

// Workspace automation policy. External actions (publishing, sending) only
// happen as this policy allows; limits are enforced by the runner.
model AutomationSettings {
  id                      String         @id @default(uuid()) @db.Char(36)
  workspaceId             String         @unique @map("workspace_id") @db.Char(36)
  mode                    AutomationMode @default(DRAFT_ONLY)
  dailyPublishLimit       Int            @default(10) @map("daily_publish_limit")
  dailyEmailLimit         Int            @default(200) @map("daily_email_limit")
  requireSeparateApprover Boolean        @default(false) @map("require_separate_approver")
  timezone                String         @default("Europe/London") @db.VarChar(60)
  updatedById             String?        @map("updated_by_id") @db.Char(36)
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("automation_settings")
}

enum IntegrationType {
  WEBHOOK
  TELEGRAM
  FACEBOOK_PAGE
}

enum IntegrationStatus {
  ACTIVE
  DISABLED
  ERROR
}

// Connected channel. `config` holds non-secret settings; secrets are AES-256-GCM
// encrypted with INTEGRATIONS_ENCRYPTION_KEY and never returned by the API.
model Integration {
  id              String            @id @default(uuid()) @db.Char(36)
  workspaceId     String            @map("workspace_id") @db.Char(36)
  type            IntegrationType
  name            String            @db.VarChar(120)
  config          Json
  secretEncrypted String            @map("secret_encrypted") @db.Text
  status          IntegrationStatus @default(ACTIVE)
  lastUsedAt      DateTime?         @map("last_used_at")
  lastError       String?           @map("last_error") @db.VarChar(500)
  createdById     String            @map("created_by_id") @db.Char(36)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scheduledItems ScheduledItem[]

  @@index([workspaceId, deletedAt])
  @@map("integrations")
}

enum ScheduledSource {
  SOCIAL_POST
  EMAIL_CAMPAIGN
  CUSTOM
}

enum ScheduledStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHING
  PUBLISHED
  MANUAL_DUE
  FAILED
  CANCELLED
}

// One planned outward action (post, campaign send). Content is a snapshot of
// what was approved, so later edits to the source can't change it unnoticed.
model ScheduledItem {
  id            String          @id @default(uuid()) @db.Char(36)
  workspaceId   String          @map("workspace_id") @db.Char(36)
  businessId    String          @map("business_id") @db.Char(36)
  title         String          @db.VarChar(200)
  sourceType    ScheduledSource @map("source_type")
  sourceId      String?         @map("source_id") @db.Char(36)
  integrationId String?         @map("integration_id") @db.Char(36)
  content       Json
  scheduledAt   DateTime        @map("scheduled_at")
  status        ScheduledStatus @default(DRAFT)
  requestedById String          @map("requested_by_id") @db.Char(36)
  approvedById  String?         @map("approved_by_id") @db.Char(36)
  approvedAt    DateTime?       @map("approved_at")
  decisionNote  String?         @map("decision_note") @db.VarChar(500)
  publishedAt   DateTime?       @map("published_at")
  externalUrl   String?         @map("external_url") @db.VarChar(500)
  attempts      Int             @default(0)
  lastError     String?         @map("last_error") @db.VarChar(500)
  lockedAt      DateTime?       @map("locked_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  metrics     PostMetric?

  @@index([status, scheduledAt])
  @@index([workspaceId, scheduledAt])
  @@index([sourceType, sourceId])
  @@map("scheduled_items")
}

// Email audience. Contacts are added only with recorded consent; every email
// carries a one-click unsubscribe link (token).
model EmailContact {
  id                String    @id @default(uuid()) @db.Char(36)
  workspaceId       String    @map("workspace_id") @db.Char(36)
  businessId        String    @map("business_id") @db.Char(36)
  email             String    @db.VarChar(254)
  name              String?   @db.VarChar(120)
  consentSource     String    @map("consent_source") @db.VarChar(200)
  consentAt         DateTime  @map("consent_at")
  unsubscribedAt    DateTime? @map("unsubscribed_at")
  // Phase 10: why sending stopped when not unsubscribed by the person (bounced / complained).
  suppressionReason String?   @map("suppression_reason") @db.VarChar(20)
  unsubscribeToken  String    @unique @map("unsubscribe_token") @db.Char(43)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deliveries EmailDelivery[]

  @@unique([businessId, email])
  @@index([workspaceId])
  @@map("email_contacts")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model EmailCampaign {
  id          String         @id @default(uuid()) @db.Char(36)
  workspaceId String         @map("workspace_id") @db.Char(36)
  businessId  String         @map("business_id") @db.Char(36)
  name        String         @db.VarChar(160)
  subject     String         @db.VarChar(200)
  preheader   String         @default("") @db.VarChar(200)
  content     Json
  status      CampaignStatus @default(DRAFT)
  sentCount   Int            @default(0) @map("sent_count")
  failedCount Int            @default(0) @map("failed_count")
  sentAt      DateTime?      @map("sent_at")
  isMock      Boolean        @default(false) @map("is_mock")
  createdById String         @map("created_by_id") @db.Char(36)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deliveries EmailDelivery[]

  @@index([workspaceId, deletedAt])
  @@map("email_campaigns")
}

// One email to one contact (idempotent sending; counts against daily limits).
model EmailDelivery {
  id                String    @id @default(uuid()) @db.Char(36)
  campaignId        String    @map("campaign_id") @db.Char(36)
  contactId         String    @map("contact_id") @db.Char(36)
  status            String    @db.VarChar(20)
  provider          String    @db.VarChar(40)
  // Phase 10: the email provider's message id (matches bounce/complaint webhooks).
  providerMessageId String?   @unique @map("provider_message_id") @db.VarChar(255)
  error             String?   @db.VarChar(300)
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  EmailContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  events   EmailEvent[]

  @@unique([campaignId, contactId])
  @@index([createdAt])
  @@map("email_deliveries")
}

model Reminder {
  id          String    @id @default(uuid()) @db.Char(36)
  workspaceId String    @map("workspace_id") @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  createdById String    @map("created_by_id") @db.Char(36)
  title       String    @db.VarChar(200)
  note        String?   @db.VarChar(1000)
  link        String?   @db.VarChar(300)
  dueAt       DateTime  @map("due_at")
  firedAt     DateTime? @map("fired_at")
  doneAt      DateTime? @map("done_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([firedAt, dueAt])
  @@index([workspaceId, userId])
  @@map("reminders")
}

// Preset automation recipes (no user code). `params` is validated per template.
model AutomationRule {
  id          String    @id @default(uuid()) @db.Char(36)
  workspaceId String    @map("workspace_id") @db.Char(36)
  template    String    @db.VarChar(60)
  name        String    @db.VarChar(160)
  params      Json
  enabled     Boolean   @default(true)
  lastRunAt   DateTime? @map("last_run_at")
  createdById String    @map("created_by_id") @db.Char(36)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, deletedAt])
  @@map("automation_rules")
}

// Automation history: every decision the runner or a person made about automated work.
model AutomationRun {
  id          String   @id @default(uuid()) @db.Char(36)
  workspaceId String   @map("workspace_id") @db.Char(36)
  kind        String   @db.VarChar(40)
  outcome     String   @db.VarChar(20)
  message     String   @db.VarChar(500)
  ruleId      String?  @map("rule_id") @db.Char(36)
  itemId      String?  @map("item_id") @db.Char(36)
  actorId     String?  @map("actor_id") @db.Char(36)
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("automation_runs")
}

// Lease locks for background jobs (one automation run at a time across instances).
model JobLock {
  name        String   @id @db.VarChar(80)
  owner       String   @db.Char(36)
  lockedUntil DateTime @map("locked_until")

  @@map("job_locks")
}

// ─── Phase 9: Analytics & Business Intelligence ──────────────────────────────

/// One page view of a published site. Cookieless: visitor_hash is a salted
/// HMAC of (day, site, IP, user agent) that rotates daily; the IP is never stored.
model SiteView {
  id           BigInt   @id @default(autoincrement())
  websiteId    String   @map("website_id") @db.Char(36)
  workspaceId  String   @map("workspace_id") @db.Char(36)
  day          DateTime @db.Date
  path         String   @db.VarChar(64)
  referrerHost String?  @map("referrer_host") @db.VarChar(253)
  visitorHash  String   @map("visitor_hash") @db.Char(64)
  device       String   @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at")

  website   Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([websiteId, day])
  @@index([workspaceId, day])
  @@index([createdAt])
  @@map("site_views")
}

/// First open / first click of a campaign email (one row per delivery and type).
model EmailEvent {
  id          BigInt   @id @default(autoincrement())
  deliveryId  String   @map("delivery_id") @db.Char(36)
  campaignId  String   @map("campaign_id") @db.Char(36)
  workspaceId String   @map("workspace_id") @db.Char(36)
  type        String   @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at")

  delivery  EmailDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, type])
  @@index([workspaceId, createdAt])
  @@index([campaignId, type])
  @@map("email_events")
}

/// Results of a published post, entered by the team from the platform's insights.
model PostMetric {
  id              String   @id @default(uuid()) @db.Char(36)
  workspaceId     String   @map("workspace_id") @db.Char(36)
  businessId      String   @map("business_id") @db.Char(36)
  scheduledItemId String   @unique @map("scheduled_item_id") @db.Char(36)
  reach           Int?
  impressions     Int?
  likes           Int?
  comments        Int?
  shares          Int?
  saves           Int?
  clicks          Int?
  recordedById    String   @map("recorded_by_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  item      ScheduledItem @relation(fields: [scheduledItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("post_metrics")
}

/// A saved performance report: the computed metrics snapshot plus AI insights.
model AnalyticsReport {
  id          String   @id @default(uuid()) @db.Char(36)
  workspaceId String   @map("workspace_id") @db.Char(36)
  businessId  String?  @map("business_id") @db.Char(36)
  periodDays  Int      @map("period_days")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  metrics     Json
  insights    Json
  isMock      Boolean  @default(false) @map("is_mock")
  createdById String   @map("created_by_id") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business  Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("analytics_reports")
}

model AnalyticsSettings {
  id                   String   @id @default(uuid()) @db.Char(36)
  workspaceId          String   @unique @map("workspace_id") @db.Char(36)
  trackSiteVisits      Boolean  @default(true) @map("track_site_visits")
  trackEmailEngagement Boolean  @default(true) @map("track_email_engagement")
  retentionDays        Int      @default(395) @map("retention_days")
  updatedById          String?  @map("updated_by_id") @db.Char(36)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("analytics_settings")
}

// ─── Phase 10: SaaS administration ──────────────────────────────────────────

/// Invitation to join a workspace. Only the SHA-256 hash of the token is stored.
model WorkspaceInvitation {
  id          String        @id @default(uuid()) @db.Char(36)
  workspaceId String        @map("workspace_id") @db.Char(36)
  email       String        @db.VarChar(320)
  role        WorkspaceRole
  tokenHash   String        @unique @map("token_hash") @db.Char(64)
  invitedById String        @map("invited_by_id") @db.Char(36)
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, acceptedAt])
  @@index([email])
  @@map("workspace_invitations")
}

enum PlanKey {
  FREE
  PRO
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

/// The workspace's plan. Without a row the workspace is on FREE. Stripe is the source of truth for paid plans
/// (kept in sync by the webhook); `source = ADMIN` marks a plan assigned by a platform admin.
model Subscription {
  id                   String             @id @default(uuid()) @db.Char(36)
  workspaceId          String             @unique @map("workspace_id") @db.Char(36)
  plan                 PlanKey            @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  source               String             @default("STRIPE") @db.VarChar(10)
  stripeCustomerId     String?            @unique @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripePriceId        String?            @map("stripe_price_id") @db.VarChar(255)
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// Extra AI credits (top-ups and admin grants, positive) and their use beyond the monthly allowance (negative).
model AiCreditEntry {
  id          String   @id @default(uuid()) @db.Char(36)
  workspaceId String   @map("workspace_id") @db.Char(36)
  amount      Int
  kind        String   @db.VarChar(20)
  reference   String?  @db.VarChar(255)
  note        String?  @db.VarChar(300)
  createdById String?  @map("created_by_id") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([kind, reference])
  @@index([workspaceId, createdAt])
  @@map("ai_credit_entries")
}

/// Processed Stripe webhook events (idempotency).
model BillingEvent {
  id          String   @id @db.VarChar(255)
  type        String   @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("billing_events")
}

/// An agency's client: links the agency workspace to the client's own workspace.
model AgencyClient {
  id                String   @id @default(uuid()) @db.Char(36)
  agencyWorkspaceId String   @map("agency_workspace_id") @db.Char(36)
  clientWorkspaceId String   @unique @map("client_workspace_id") @db.Char(36)
  contactName       String?  @map("contact_name") @db.VarChar(120)
  contactEmail      String?  @map("contact_email") @db.VarChar(320)
  status            String   @default("ACTIVE") @db.VarChar(20)
  notes             String?  @db.Text
  createdById       String   @map("created_by_id") @db.Char(36)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  agency Workspace @relation("AgencyClientAgency", fields: [agencyWorkspaceId], references: [id], onDelete: Cascade)
  client Workspace @relation("AgencyClientWorkspace", fields: [clientWorkspaceId], references: [id], onDelete: Cascade)

  @@index([agencyWorkspaceId, status])
  @@map("agency_clients")
}

/// Platform-wide switches set by platform admins (e.g. pausing AI generation).
model PlatformSetting {
  key         String   @id @db.VarChar(60)
  value       Json
  updatedById String?  @map("updated_by_id") @db.Char(36)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// An approved (or approved after editing) AI output, reused as a style example for the same business and task.
model AiExample {
  id          String   @id @default(uuid()) @db.Char(36)
  workspaceId String   @map("workspace_id") @db.Char(36)
  businessId  String   @map("business_id") @db.Char(36)
  module      String   @db.VarChar(40)
  task        String   @db.VarChar(60)
  source      String   @db.VarChar(10)
  content     Json
  sourceRef   String   @unique @map("source_ref") @db.VarChar(80)
  createdById String?  @map("created_by_id") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, module, task, updatedAt])
  @@index([workspaceId])
  @@map("ai_examples")
}
