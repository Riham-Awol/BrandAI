# ─────────────────────────────────────────────────────────────
# Brand AI — environment variables (placeholders only)
# Copy to .env for local development. NEVER commit real values.
# Vercel: set these per environment (Development / Preview=staging / Production).
# ─────────────────────────────────────────────────────────────

# App
APP_ENV="development"                 # development | test | staging | production
APP_URL="http://localhost:3000"       # public base URL, used in emails

# Database (MySQL 8). Managed providers usually need TLS: append ?sslaccept=strict
DATABASE_URL="mysql://brandai:CHANGE_ME@127.0.0.1:3306/brandai_dev"
# Only needed by `prisma migrate dev` (local). Any empty database the user can create/drop.
SHADOW_DATABASE_URL="mysql://brandai:CHANGE_ME@127.0.0.1:3306/brandai_shadow"

# Authentication (Auth.js / NextAuth v4)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="http://localhost:3000"

# AI — text generation (FREE options; all use the OpenAI-compatible API)
#   gemini      Google Gemini free tier — get a key at https://aistudio.google.com/apikey   (default)
#   groq        Groq free tier          — https://console.groq.com/keys
#   openrouter  OpenRouter free models  — https://openrouter.ai/keys  (models ending in ":free")
#   ollama      Ollama on your own machine, no key — https://ollama.com (not for Vercel)
#   openai_compatible  any other OpenAI-compatible endpoint (set AI_BASE_URL + AI_TEXT_MODEL)
#   anthropic   paid (ANTHROPIC_API_KEY)
#   mock        tests/offline dev only, refused in production
# Free tiers are rate-limited and have their own data-use terms — review them before production use.
AI_TEXT_PROVIDER="gemini"
AI_TEXT_MODEL=""                      # optional override; default depends on the provider (Gemini: gemini-flash-latest)
AI_TEXT_FALLBACK_MODELS=""            # optional comma list tried when a model is retired/overloaded/rate-limited
AI_BASE_URL=""                        # optional override of the provider endpoint
AI_TEXT_FALLBACK_PROVIDERS=""         # optional free providers tried when the main one is busy, e.g. "openrouter,groq"
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""                 # only ":free" models are ever used, even if the key has credit
AI_API_KEY=""                         # key for openai_compatible
ANTHROPIC_API_KEY=""                  # only for AI_TEXT_PROVIDER=anthropic (paid)
# AI — image generation (provider selected in Phase 2)
AI_IMAGE_PROVIDER="none"              # none | mock
AI_ALLOW_MOCK="false"                 # must stay false outside development/test

# File storage (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, MinIO)
STORAGE_PROVIDER="database"           # database (free, built-in, ≤5 MB files) | s3 | memory (tests only) | none
S3_ENDPOINT=""                        # empty for AWS; e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"           # true for MinIO
S3_PUBLIC_BASE_URL=""

# Email
EMAIL_PROVIDER="console"              # console (dev only: logs emails) | resend | none
EMAIL_FROM="Brand AI <no-reply@example.com>"
RESEND_API_KEY=""

# Rate limiting store
RATE_LIMIT_STORE="database"           # database (multi-instance safe) | memory (single process)
